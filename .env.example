# Copy to .env and fill in real values. Never commit .env.

# --- LLM (OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend (NEXT_PUBLIC_* is exposed to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI ---
# Directory where the chat vector store is persisted
VECTORSTORE_DIR=ai/data/vectorstore
# "remote" (LLM API) or "local" (sentence-transformers, needs the [embeddings] extra)
EMBEDDING_BACKEND=remote
