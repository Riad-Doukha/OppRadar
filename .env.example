# Copy to .env and fill in real values. Never commit .env.
# AI-only settings (LLM provider, OCR, thresholds) live in ai/.env.example;
# the AI package reads both ai/.env and this root .env.

# --- LLM (see ai/.env.example for every option) ---
# fake = offline canned answers (no key); gemini needs GEMINI_API_KEY
LLM_PROVIDER=fake
GEMINI_API_KEY=

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave empty to
# verify tokens against the project's JWKS (new signing keys).
SUPABASE_JWT_SECRET=

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
# supabase | memory (memory = throwaway in-process data, for tests/demos without a DB)
DATA_BACKEND=supabase
UPLOAD_MAX_MB=5
UPLOAD_MAX_PAGES=10
# Where the rate limits read the client IP behind a proxy: "" = the TCP peer
# (local), x-forwarded-for = its last entry. Check it with Admin -> Ingest.
CLIENT_IP_HEADER=
# The agent's timer (ingestion + matching + retention). On ONE instance only.
AGENT_SCHEDULER=0
AGENT_INTERVAL_SECONDS=3600
# Shared read-only demo account ("Try the demo instead"); created by
# `python backend/scripts/seed.py --demo`
DEMO_EMAIL=demo@oppradar.app
DEMO_PASSWORD=

# --- Email (Gmail API) ---
# Every email (alerts, digests, and Supabase Auth's confirm / reset / change
# email via the Send Email hook) goes out through this Gmail account.
# Without GMAIL_* emails are only logged. Refresh token: backend/scripts/gmail_auth.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Must be the Gmail account itself (or one of its "Send mail as" aliases)
MAIL_FROM=OppRadar <your.account@gmail.com>
# Supabase -> Authentication -> Hooks -> Send Email (HTTPS), "v1,whsec_..."
SUPABASE_EMAIL_HOOK_SECRET=
# Signs the unsubscribe links in alert emails (random, 32+ bytes)
EMAIL_SECRET=
# Links in emails: the web app, and the API (unsubscribe)
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Frontend (NEXT_PUBLIC_* is exposed to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shown on /terms and /privacy when set
NEXT_PUBLIC_CONTACT_EMAIL=
