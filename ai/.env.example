# OppRadar AI configuration — copy to ai/.env and fill in.
# Only names live here; NEVER put real values in this file.

# --- LLM provider: gemini | ollama | fake -----------------------------------
# "fake" needs no network and no key: everything runs offline on canned data.
LLM_PROVIDER=fake

# Google Gemini Flash (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried ONCE when the primary model keeps failing on transient errors (5xx /
# timeouts) after its retries; empty disables the fallback. The cache records
# the model that really answered, so you always know which one produced a row.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Latency: no thinking (0 = cheapest and fastest; -1 = never send the config)
# and a hard cap on the answer size. Extraction JSON is small, so 2048 is a
# safety net rather than a target — it stops a runaway answer, not a good one.
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- Live opt-in (shell or .env) -----------------------------------------------
# Settings field `run_live_llm`: Unset/empty -> everything runs offline — the
# notebooks take their OFFLINE branches, and ingestion NEVER fetches a missing
# deadline's detail page ("detail fetch skipped (offline)" in the log), even
# with the keys above filled in. RUN_LIVE_LLM=1 allows those live steps, each
# still capped by its own per-run budget.
# RUN_LIVE_LLM=1

# Optional local provider (no key needed, must be running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Web discovery (Tavily free tier) ---------------------------------------
# Key at https://app.tavily.com — used by ingestion/search.py
TAVILY_API_KEY=
# Hard per-run caps on REMOTE calls (free-tier protection). Disk-cache hits
# are free and always allowed; over the cap, calls are skipped and reported as
# "pending LLM" (never stored as junk records) so the next run retries them.
TAVILY_MAX_SEARCHES_PER_RUN=5
MAX_EXTRACTIONS_PER_RUN=20
# Accepted feed entry with no deadline -> one capped detail-page re-extraction
MAX_DETAIL_FETCHES_PER_RUN=5
# RSS bodies are truncated to this many chars before the LLM
FEED_TEXT_MAX_CHARS=6000

# Polite crawling (ingestion/fetch.py): one clear identity per request
USER_AGENT="OppRadarBot/0.1 (student project; https://github.com/Riad-Doukha/OppRadar)"
# Pause between HTTP requests to the same origin (seconds)
FETCH_DELAY_SECONDS=1.5
FETCH_TIMEOUT_SECONDS=15.0
# Honour robots.txt: disallowed URLs are skipped and reported, unreachable
# robots.txt counts as "allow" (standard practice)
RESPECT_ROBOTS=true

# --- Embeddings (local sentence-transformers) --------------------------------
# Default is accurate but heavy (~2.3 GB download). Lighter fallback listed below.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FALLBACK_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- OCR (rapidocr, local) ----------------------------------------------------
# Page render resolution when a PDF has no text layer. 220 reads the sample
# scans correctly; 150 garbles long lines. Higher = better but slower (~4 s/page).
OCR_DPI=220
# Drop OCR lines scoring below this (rapidocr's own default is 0.5, which
# discards whole lines on hard-to-read scans).
OCR_TEXT_SCORE=0.3

# --- Thresholds ---------------------------------------------------------------
# Fields extracted below this confidence are marked "to verify"
CONFIDENCE_THRESHOLD=0.65
# Match score at/above which an LLM may phrase the "reasons" (still rules first)
NOTIFY_THRESHOLD=70
# Scoring weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.5
CRITERIA_WEIGHT=0.35
BONUS_WEIGHT=0.15

# --- Notifications -------------------------------------------------------------
DAILY_INSTANT_CAP=5
QUIET_HOURS_START=22
QUIET_HOURS_END=8
DIGEST_MODE=instant

# --- Agent ---------------------------------------------------------------------
AGENT_INTERVAL_SECONDS=3600
DEMO_INTERVAL_SECONDS=10

# --- Cost control --------------------------------------------------------------
# Minimum delay between LLM calls + retry policy for transient errors (5xx,
# timeouts): exponential backoff with jitter, at most LLM_MAX_RETRIES attempts
# per call. Quota errors (429) are NEVER retried — the item becomes "pending
# LLM" and the rest of the run stops touching the provider.
LLM_MIN_DELAY_SECONDS=1.0
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_WAIT=2.0
# Long inputs are truncated before being sent to the LLM
LLM_MAX_INPUT_CHARS=8000

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
